{
  "version": "2.1.0",
  "description": "Dynamic pattern regex lookup table for AccessibleIMPACT NLP engine",
  "rules": [
    {
      "id": "property_dialog_layout",
      "category": "game",
      "pattern": "^(?:bottom|top|center|full\\s*screen)$",
      "template": "isolated_pill",
      "blockType": "property_pill",
      "params": {
        "prop": 0,
        "pillCategory": "game"
      }
    },
    {
      "id": "property_direction",
      "category": "scene",
      "pattern": "^(?:left|right|up|down)$",
      "template": "isolated_pill",
      "blockType": "property_pill",
      "params": {
        "prop": 0,
        "pillCategory": "scene"
      }
    },
    {
      "id": "property_statusbar",
      "category": "statusbars",
      "pattern": "^(?:value|max|zero)$",
      "template": "isolated_pill",
      "blockType": "property_pill",
      "params": {
        "prop": 0,
        "pillCategory": "statusbars"
      }
    },
    {
      "id": "property_statusbar_kind",
      "category": "statusbars",
      "pattern": "^(?:Health|Hunger|Energy|Magic|Life|Heat|Cold)$",
      "template": "isolated_pill",
      "blockType": "property_pill",
      "params": {
        "prop": 0,
        "pillCategory": "statusbars_kind"
      }
    },
    {
      "id": "sprites_create_char",
      "category": "sprites",
      "pattern": "^(?:set\\s+(?:\\[?([a-zA-Z0-9_]+)\\]?|sprite)\\s+to\\s+)?sprite(?:\\s*\\(img\\))?\\s*of\\s*kind(?:\\s*[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "variables_set_mySprite_spritescreate",
      "blockType": "variables_set",
      "params": {
        "varName": 1,
        "kind": 2
      }
    },
    {
      "id": "sprites_create_reporter",
      "category": "sprites",
      "pattern": "^sprite(?:\\s*\\(img\\))?\\s*of\\s*kind(?:\\s*[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?$",
      "template": "spritescreatenoset",
      "blockType": "spritescreatenoset",
      "params": {
        "kind": 1
      }
    },
    {
      "id": "sprites_all_of_kind",
      "category": "sprites",
      "pattern": "^(?:array\\s+of\\s+sprites|all\\s+sprites|sprites|all)\\s+of\\s+kind(?:\\s*[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "allOfKind",
      "blockType": "allOfKind",
      "params": {
        "kind": 1
      }
    },
    {
      "id": "sprites_set_position",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+position\\s+to(?:\\s*x\\s*([\\d-]+)\\s*y\\s*([\\d-]+))?",
      "template": "spritesetpos",
      "blockType": "spritesetpos",
      "params": {
        "varName": 1,
        "x": 2,
        "y": 3
      }
    },
    {
      "id": "sprites_set_velocity",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+velocity\\s+to(?:\\s*vx\\s*([\\d-]+)\\s*vy\\s*([\\d-]+))?",
      "template": "spritesetvel",
      "blockType": "spritesetvel",
      "params": {
        "varName": 1,
        "vx": 2,
        "vy": 3
      }
    },
    {
      "id": "sprites_prop_set",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s*[\\[\\(]?(velocity\\s*[xy]|vx|vy|ax|ay|x|y|scale|lifespan)[\\]\\)]?\\s+to(?:\\s+[\\[\\(]?([\\d-]+)[\\]\\)]?)?",
      "template": "Sprite_blockCombine_set",
      "blockType": "Sprite_blockCombine_set",
      "params": {
        "varName": 1,
        "prop": 2,
        "val": 3
      }
    },
    {
      "id": "sprites_prop_change",
      "category": "sprites",
      "pattern": "^change\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s*[\\[\\(]?(velocity\\s*[xy]|vx|vy|ax|ay|x|y|scale|lifespan)[\\]\\)]?(?:\\s+by(?:\\s+[\\[\\(]?([\\d-]+)[\\]\\)]?)?)?",
      "template": "Sprite_blockCombine_change",
      "blockType": "Sprite_blockCombine_change",
      "params": {
        "varName": 1,
        "prop": 2,
        "val": 3
      }
    },
    {
      "id": "sprites_prop_get",
      "category": "sprites",
      "pattern": "^(?:(?:mySprite|sprite|[\\[\\(]?[a-zA-Z0-9_]+[\\]\\)]?)\\s+)?(velocity\\s*[xy]|vx|vy|ax|ay|x|y|scale|lifespan)$",
      "template": "Sprite_blockCombine_get",
      "blockType": "Sprite_blockCombine_get",
      "params": {
        "prop": 1
      }
    },
    {
      "id": "sprites_set_image",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+image\\s+to",
      "template": "spritesetimage",
      "blockType": "spritesetimage",
      "params": {
        "varName": 1
      }
    },
    {
      "id": "sprites_set_kind",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+kind\\s+to(?:\\s+[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "spritesetkind",
      "blockType": "spritesetkind",
      "params": {
        "varName": 1,
        "kind": 2
      }
    },
    {
      "id": "sprites_set_stay_in_screen",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+stay\\s+in\\s+screen(?:\\s+[\\[\\(]?(ON|OFF)[\\]\\)]?)?",
      "template": "spritesetsetstayinscreen",
      "blockType": "spritesetsetstayinscreen",
      "params": {
        "varName": 1,
        "val": 2
      }
    },
    {
      "id": "sprites_set_bounce_on_wall",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+bounce\\s+on\\s+wall(?:\\s+[\\[\\(]?(ON|OFF)[\\]\\)]?)?",
      "template": "spritesetsetbounceonwall",
      "blockType": "spritesetsetbounceonwall",
      "params": {
        "varName": 1,
        "val": 2
      }
    },
    {
      "id": "sprites_follow",
      "category": "sprites",
      "pattern": "^set\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+follow(?:\\s+(?:otherSprite|sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?))?",
      "template": "spriteFollowOtherSprite",
      "blockType": "spriteFollowOtherSprite",
      "params": {
        "follower": 1,
        "target": 2
      }
    },
    {
      "id": "sprites_destroy",
      "category": "sprites",
      "pattern": "^destroy\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)",
      "template": "spritedestroy2",
      "blockType": "spritedestroy2",
      "params": {
        "varName": 1
      }
    },
    {
      "id": "sprites_destroy_all_of_kind",
      "category": "sprites",
      "pattern": "^destroy\\s+all\\s+sprites\\s+of\\s+kind(?:\\s+[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "sprites_destroy_all_sprites_of_kind",
      "blockType": "sprites_destroy_all_sprites_of_kind",
      "params": {
        "kind": 1
      }
    },
    {
      "id": "sprites_say",
      "category": "sprites",
      "pattern": "^(?:(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+)?say(?:\\s+[\\[\\(]?\"?([^\"\\]\\)]*)\"?[\\]\\)]?)?",
      "template": "spritesaytext",
      "blockType": "spritesaytext",
      "params": {
        "varName": 1,
        "text": 2
      }
    },
    {
      "id": "sprites_start_effect",
      "category": "sprites",
      "pattern": "^(?:(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+)?start(?:\\s+([a-zA-Z0-9_]+))?\\s+effect",
      "template": "startEffectOnSprite",
      "blockType": "startEffectOnSprite",
      "params": {
        "varName": 1,
        "effect": 2
      }
    },
    {
      "id": "sprites_overlap_event",
      "category": "sprites",
      "pattern": "^(?:run\\s+code\\s+on\\s+)?on\\s+(?:sprite\\s+)?(?:of\\s+kind\\s+)?[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?\\s+overlaps\\s+(?:otherSprite\\s+)?(?:of\\s+kind\\s+)?[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?",
      "template": "spritesoverlap",
      "blockType": "spritesoverlap",
      "params": {
        "kind1": 1,
        "kind2": 2
      }
    },
    {
      "id": "sprites_hit_wall_event",
      "category": "sprites",
      "pattern": "^on\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+hits\\s+wall(?:\\s+at\\s+[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "spriteshitwall",
      "blockType": "spriteshitwall",
      "params": {
        "varName": 1,
        "direction": 2
      }
    },
    {
      "id": "sprites_overlap_condition",
      "category": "sprites",
      "pattern": "^(?:mySprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+overlaps\\s+with\\s+(?:otherSprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)",
      "template": "spriteoverlapswith",
      "blockType": "spriteoverlapswith",
      "params": {
        "var1": 1,
        "var2": 2
      }
    },
    {
      "id": "sprites_projectile_from_sprite",
      "category": "sprites",
      "pattern": "^(?:set\\s+[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?\\s+to\\s+)?projectile\\s+from\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)",
      "template": "variables_set_projectile_createfromsprite",
      "blockType": "variables_set",
      "params": {
        "varName": 1,
        "parentSprite": 2
      }
    },
    {
      "id": "sprites_projectile_from_side",
      "category": "sprites",
      "pattern": "^(?:set\\s+[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?\\s+to\\s+)?projectile\\s+from\\s+side",
      "template": "variables_set_projectile_createfromside",
      "blockType": "variables_set",
      "params": {
        "varName": 1
      }
    },
    {
      "id": "sprites_on_created",
      "category": "sprites",
      "pattern": "^on\\s+created(?:\\s+(?:sprite\\s+)?(?:of\\s+kind\\s+)?[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "spritesoncreated",
      "blockType": "spritesoncreated",
      "params": {
        "kind": 1
      }
    },
    {
      "id": "sprites_on_destroyed",
      "category": "sprites",
      "pattern": "^on\\s+destroyed(?:\\s+(?:sprite\\s+)?(?:of\\s+kind\\s+)?[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "spritesondestroyed",
      "blockType": "spritesondestroyed",
      "params": {
        "kind": 1
      }
    },
    {
      "id": "controller_on_button_pressed",
      "category": "controller",
      "pattern": "^on\\s+(?:\\[?([a-zA-Z0-9_ ]+?)\\]?\\s+)?button\\s+pressed",
      "template": "keyonevent",
      "blockType": "keyonevent",
      "params": {
        "button": 1
      }
    },
    {
      "id": "controller_is_button_pressed",
      "category": "controller",
      "pattern": "^is\\s+(?:\\[?([a-zA-Z0-9_ ]+?)\\]?\\s+)?button\\s+pressed",
      "template": "keyispressed",
      "blockType": "keyispressed",
      "params": {
        "button": 1
      }
    },
    {
      "id": "controller_move_with_buttons",
      "category": "controller",
      "pattern": "^move\\s+(?:sprite|[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)\\s+with\\s+buttons",
      "template": "game_control_sprite",
      "blockType": "game_control_sprite",
      "params": {
        "varName": 1
      }
    },
    {
      "id": "tileUtil_create_sprites_on_tiles",
      "category": "tileUtil",
      "pattern": "^on\\s+each(?:\\s+.*)?\\s+tile\\s+create\\s+sprite(?:\\s+with\\s+image)?(?:\\s+and\\s+kind)?(?:\\s*[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "tileUtil_createSpritesOnTiles",
      "blockType": "tileUtil_createSpritesOnTiles",
      "params": {
        "kind": 1
      }
    },
    {
      "id": "tileUtil_set_tile_at",
      "category": "tileUtil",
      "pattern": "^set\\s+(?:.*\\s+)?tile\\s+at(?:\\s+location|\\s+tilemap\\s+col)?",
      "template": "tileUtil_setTileAt",
      "blockType": "tileUtil_setTileAt"
    },
    {
      "id": "tileUtil_set_wall_at",
      "category": "tileUtil",
      "pattern": "^set\\s+wall\\s+at(?:\\s+tilemap\\s+col)?",
      "template": "tileUtil_setWallAt",
      "blockType": "tileUtil_setWallAt"
    },
    {
      "id": "tileUtil_cover_all_tiles",
      "category": "tileUtil",
      "pattern": "^cover\\s+all\\s+.*tiles\\s+with",
      "template": "tileUtil_coverAllTiles",
      "blockType": "tileUtil_coverAllTiles"
    },
    {
      "id": "tileUtil_replace_all_tiles",
      "category": "tileUtil",
      "pattern": "^replace\\s+all\\s+.*tiles\\s+with",
      "template": "tileUtil_replaceAllTiles",
      "blockType": "tileUtil_replaceAllTiles"
    },
    {
      "id": "tileUtil_set_walls",
      "category": "tileUtil",
      "pattern": "^set\\s+walls\\s+on\\s+all\\s+.*tiles",
      "template": "tileUtil_setWalls",
      "blockType": "tileUtil_setWalls"
    },
    {
      "id": "tileUtil_tile_is",
      "category": "tileUtil",
      "pattern": "^tile\\s+at\\s+.*is\\s+tile",
      "template": "tileUtil_tileIs",
      "blockType": "tileUtil_tileIs"
    },
    {
      "id": "tileUtil_get_loaded_map",
      "category": "tileUtil",
      "pattern": "^current\\s+tilemap$",
      "template": "tileUtil_getLoadedMap",
      "blockType": "tileUtil_getLoadedMap"
    },
    {
      "id": "tileScanner_scan_in_direction",
      "category": "tileScanner",
      "pattern": "^scan\\s+(?:from\\s+)?tilemap(?:\\s+col.*)?\\s+in\\s+direction(?:\\s+[\\[\\(]?([a-zA-Z0-9_]+)[\\]\\)]?)?",
      "template": "tileScanner_scanInDirection",
      "blockType": "tileScanner_scanInDirection",
      "params": {
        "direction": 1
      }
    },
    {
      "id": "tileScanner_all_matching",
      "category": "tileScanner",
      "pattern": "^(?:all\\s+)?tilemap\\s+locations\\s+matching",
      "template": "tileScanner_getAllMatchingLocations",
      "blockType": "tileScanner_getAllMatchingLocations"
    },
    {
      "id": "tileScanner_adjacent",
      "category": "tileScanner",
      "pattern": "^adjacent\\s+locations\\s+to",
      "template": "tileScanner_getAdjacentLocations",
      "blockType": "tileScanner_getAdjacentLocations"
    },
    {
      "id": "tileScanner_scan_lines",
      "category": "tileScanner",
      "pattern": "^scan\\s+for\\s+lines\\s+in\\s+direction",
      "template": "tileScanner_scanForLines",
      "blockType": "tileScanner_scanForLines"
    },
    {
      "id": "tileScanner_scan_groups",
      "category": "tileScanner",
      "pattern": "^scan\\s+for\\s+groups",
      "template": "tileScanner_scanForGroups",
      "blockType": "tileScanner_scanForGroups"
    },
    {
      "id": "scroller_camera",
      "category": "scroller",
      "pattern": "^scroll\\s+background\\s+with\\s+camera(?:\\s+[\\[\\(]?(only\\s*horizontally|only\\s*vertically|both\\s*directions)[\\]\\)]?)?",
      "template": "scroller_scrollBackgroundWithCamera",
      "blockType": "scroller_scrollBackgroundWithCamera",
      "params": {
        "mode": 1
      }
    },
    {
      "id": "scroller_speed",
      "category": "scroller",
      "pattern": "^scroll\\s+background\\s+with(?:\\s+speed|\\s+vx)?",
      "template": "scroller_scrollBackgroundWithSpeed",
      "blockType": "scroller_scrollBackgroundWithSpeed"
    },
    {
      "id": "scroller_multipliers",
      "category": "scroller",
      "pattern": "^set\\s+(?:background\\s+)?camera\\s+scroll(?:ing)?\\s+multipliers",
      "template": "scroller_setCameraScrollingMultipliers",
      "blockType": "scroller_setCameraScrollingMultipliers"
    },
    {
      "id": "scroller_offset",
      "category": "scroller",
      "pattern": "^set\\s+background\\s+(?:scroll\\s+)?offset",
      "template": "scroller_setBackgroundScrollOffset",
      "blockType": "scroller_setBackgroundScrollOffset"
    },
    {
      "id": "scroller_layer_image",
      "category": "scroller",
      "pattern": "^set\\s+(?:scroller\\s+)?layer\\s+image",
      "template": "scroller_setLayerImage",
      "blockType": "scroller_setLayerImage"
    },
    {
      "id": "statusbars_create",
      "category": "statusbars",
      "pattern": "^(?:set\\s+\\[?(?:statusbar\\d*|sb\\d*)\\]?\\s+to.*|create\\s+status\\s*bar.*)",
      "template": "variables_set_statusbar_statusbars_create",
      "blockType": "variables_set",
      "params": {
        "varName": 1,
        "kind": 2
      }
    },
    {
      "id": "statusbars_get_prop",
      "category": "statusbars",
      "pattern": "^[\\(\\[]*\\(?\\s*(?:statusbar|sprite|[a-zA-Z0-9_]+)\\s*\\)?\\s*[\\[\\(]?(value|max|zero)[\\]\\)]*[\\)\\]]*$",
      "template": "StatusBarSprite_blockCombine_get",
      "blockType": "StatusBarSprite_blockCombine_get",
      "params": {
        "prop": 1
      }
    },
    {
      "id": "statusbars_change_prop",
      "category": "statusbars",
      "pattern": "^change\\s+(?:\\(statusbar\\)|statusbar)\\s*[\\[\\(]?(value|max)[\\]\\)]?\\s+by(?:\\s+[\\(\\[]?(-?\\d+)[\\)\\]]?)?",
      "template": "StatusBarSprite_blockCombine_change",
      "blockType": "StatusBarSprite_blockCombine_change",
      "params": {
        "prop": 1,
        "val": 2
      }
    },
    {
      "id": "statusbars_set_prop",
      "category": "statusbars",
      "pattern": "^set\\s+(?:\\(statusbar\\)|statusbar)\\s*[\\[\\(]?(value|max)[\\]\\)]?\\s+to(?:\\s+[\\(\\[]?(-?\\d+)[\\)\\]]?)?",
      "template": "StatusBarSprite_blockCombine_set",
      "blockType": "StatusBarSprite_blockCombine_set",
      "params": {
        "prop": 1,
        "val": 2
      }
    },
    {
      "id": "statusbars_set_color",
      "category": "statusbars",
      "pattern": "^set\\s+(?:\\(statusbar\\)|statusbar)\\s+fill\\s+background",
      "template": "statusbars_setColor",
      "blockType": "statusbars_setColor",
      "params": {
        "varName": "statusbar"
      }
    },
    {
      "id": "statusbars_kind_attached",
      "category": "statusbars",
      "pattern": "^status\\s*bar\\s*(?:of\\s*)?(?:kind)?\\s*attached\\s+to",
      "template": "statusbars_spriteStatusBarIsAttachedTo",
      "blockType": "statusbars_spriteStatusBarIsAttachedTo"
    },
    {
      "id": "statusbars_sprite_attached",
      "category": "statusbars",
      "pattern": "^sprite\\s+that\\s*(?:\\(statusbar\\)|statusbar)?\\s*is\\s+attached\\s+to",
      "template": "statusbars_attachSpriteGetter",
      "blockType": "statusbars_attachSpriteGetter"
    },
    {
      "id": "statusbars_attach_to",
      "category": "statusbars",
      "pattern": "^attach\\s+(?:\\(?([a-zA-Z0-9_]+)\\)?|statusbar)\\s+to\\s+(?:\\(?([a-zA-Z0-9_]+)\\)?|sprite|mySprite)",
      "template": "statusbars_attachToSprite",
      "blockType": "statusbars_attachToSprite",
      "params": {
        "statusbar": 1,
        "sprite": 2
      }
    },
    {
      "id": "mp_set_player_sprite",
      "category": "mp",
      "pattern": "^set\\s+player\\s+([1-4])\\s+sprite\\s+to",
      "template": "mp_setPlayerSprite",
      "blockType": "mp_setPlayerSprite",
      "params": {
        "player": 1
      }
    },
    {
      "id": "mp_player_selector",
      "category": "mp",
      "pattern": "^player\\s+([1-4])$",
      "template": "mp_playerSelector",
      "blockType": "mp_playerSelector",
      "params": {
        "player": 1
      }
    },
    {
      "id": "mp_get_player_sprite",
      "category": "mp",
      "pattern": "^player\\s+([1-4])\\s+sprite$",
      "template": "mp_getPlayerSprite",
      "blockType": "mp_getPlayerSprite",
      "params": {
        "player": 1
      }
    },
    {
      "id": "mp_move_with_buttons",
      "category": "mp",
      "pattern": "^move\\s+player\\s+([1-4])\\s*(?:sprite)?\\s*with\\s+buttons",
      "template": "mp_moveWithButtons",
      "blockType": "mp_moveWithButtons",
      "params": {
        "player": 1
      }
    },
    {
      "id": "animation_image",
      "category": "animation",
      "pattern": "^animate\\s+(?:[\\(\\[]?([a-zA-Z0-9_]+)[\\]\\)]?\\s+)?(?:image|frames)",
      "template": "run_image_animation",
      "blockType": "run_image_animation",
      "params": {
        "varName": 1
      }
    },
    {
      "id": "animation_movement",
      "category": "animation",
      "pattern": "^animate\\s+(?:[\\(\\[]?([a-zA-Z0-9_]+)[\\]\\)]?\\s+)?movement",
      "template": "run_movement_animation",
      "blockType": "run_movement_animation",
      "params": {
        "varName": 1
      }
