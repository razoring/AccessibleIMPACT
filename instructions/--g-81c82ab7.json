n        . . . e 5 6 6 7 2 2 6 4 4 4 e .\n        . . e 5 2 2 7 6 6 4 5 5 5 5 4 .\n        . e 5 6 2 2 8 8 5 5 5 5 5 4 5 4\n        . e 5 6 7 7 8 5 4 5 4 5 5 5 5 4\n        e 4 5 8 6 6 5 5 5 5 5 5 4 5 5 4\n        e 5 c e 8 5 5 5 4 5 5 5 5 5 5 4\n        e 5 c c e 5 4 5 5 5 4 5 5 5 e .\n        e 5 c c 5 5 5 5 5 5 5 5 4 e . .\n        e 5 e c 5 4 5 4 5 5 5 e e . . .\n        e 5 e e 5 5 5 5 5 4 e . . . . .\n        4 5 4 e 5 5 5 5 e e . . . . . .\n        . 4 5 4 5 5 4 e . . . . . . . .\n        . . 4 4 e e e . . . . . . . . .\n    `, SpriteKind.Food)\n    taco.setPosition(randint(10, 150), randint(10, 110))\n}\n\nfor (let chances = 3; chances > 0; chances++) {\n    pause(1000)\n    let guess = game.askForNumber(\"How many tacos are there? Chances Left: \" + chances, 2)\n}\n","pxt.json":"{\n    \"name\": \"Untitled\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\"\n}\n","readmE.md":null,"assets.json":"","main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"></xml>",".simstate.json":null,"images.g.jres":"","images.g.ts":"","tilemap.g.ts":"","tilemap.g.jres":"","_palettes.json":""},"header":{"id":"0c61c704-a070-488f-b4fe-982d616c49b8","meta":{},"name":"Untitled","path":"Untitled","pubId":"","editor":"tsprj","saveId":null,"target":"arcade","recentUse":1689801361,"pubCurrent":false,"cloudCurrent":false,"githubCurrent":false,"targetVersion":"4.0.12","modificationTime":1689801361,"cloudUserId":null}},"languageRestrictions":"javascript-only","noProjectRunErrors":false,"projectHasBeenRun":false},"peerReview":false,"mediaFileId":"","introduction":"<p><span style=\"background-color: transparent; color: rgb(0, 0, 0);\">Oh no - these programs aren’t working! Problems in code are called </span><strong style=\"background-color: transparent; c