{"id":"07cd6385-d236-4924-964a-d1a42fe00bc1","type":"level","createdDate":"2026-06-13T23:09:47.763Z","createdBy":"chaitanya.ponnapati@codeninjas.com","lastModifiedDate":"2026-06-13T23:09:47.763Z","lastModifiedBy":"chaitanya.ponnapati@codeninjas.com","attributes":{"tags":["CREATE"],"title":"Level 4","sequence":4,"activity":{"id":"1b465a93-c4f2-4c9b-853a-dc2b89c2a0ab","type":"activity","sequence":0,"group":{"id":"1b465a93-c4f2-4c9b-853a-dc2b89c2a0ab","type":"discover","name":null,"sequence":1,"subgroups":[{"id":"1b465a93-c4f2-4c9b-853a-dc2b89c2a0ab","type":"subgroup","sequence":1,"name":"Discover","steps":[{"id":"5b81c8d1-2475-4c74-89ef-5e99671dedae","hints":null,"senseiHelp":null,"instructions":null,"text":"<p>Watch this video to learn about using tilemap location and extension code in your projects to connect different tilemaps and create unique events with specific tiles!</p>","type":"textMedia","image":null,"videoUrl":"https://assets.codeninjas.com/clm/assets/videos/YellowBelt-9.mp4","mediaType":"video","questions":[{"hint":"Which option(s) can tilemap location and extension blocks be used for?","type":"multi-select","title":"<p><span style=\"background-color: transparent; color: rgb(0, 0, 0);\">[Select all that apply] Tilemap location and extension blocks can be used to:</span></p>","answers":[{"text":"Connect different tilemap designs ","isCorrect":true},{"text":"Code a sprite’s acceleration ","isCorrect":false},{"text":"Create a project with multiple types of tilemap perspectives ","isCorrect":true},{"text":"Set food sprites as projectiles","isCorrect":false}],"wordbank":null,"statements":null,"useWordbank":false,"correctResponse":"Tilemap location and extension blocks can help make our project more engaging for the user by including different tilemap designs and perspectives!"}],"badges":null,"reflectionQuestions":null},{"id":"c6ad9878-e792-4617-bd3b-a481fe648c7c","hints":null,"senseiHelp":null,"instructions":null,"text":"Please update text.","type":"quiz","im