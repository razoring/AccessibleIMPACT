 . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . .     . . . . . . . . . . . . . . . . `","operator":"neq","maxValue":null,"minValue":null},{"value":"","operator":"ignore","maxValue":null,"minValue":null}],"functionName":"sprites.create(img,kind)","match":null,"instanceCount":2,"effect":null,"eventType":null,"music":null,"timing":null}],"mustCompleteAll":false},{"text":"Set the positions of the 2 sprites.","type":"contains","points":10,"failureText":"<p><span style=\"background-color: transparent; color: rgb(0, 0, 0);\">Step 3</span></p>","requirements":[{"file":"main.ts","parameters":[{"value":"0","operator":"neq","maxValue":null,"minValue":null},{"value":"0","operator":"neq","maxValue":null,"minValue":null}],"functionName":"setPosition(x,y)","match":null,"instanceCount":2,"effect":null,"eventType":null,"music":null,"timing":null}],"mustCompleteAll":false},{"text":"Move the (player) sprite with the controller.","type":"contains","points":10,"failureText":"<p><span style=\"background-color: transparent; color: rgb(0, 0, 0);\">Step 4</span></p>","requirements":[{"file":"main.ts","parameters":[{"value":"mySprite","operator":"neq","maxValue":null,"minValue":null}],"functionName":"controller.moveSprite(sprite)","match":null,"instanceCount":1,"effect":null,"eventType":null,"music":null,"timing":null}],"mustCompleteAll":false},{"text":"Set the (player) sprite to stay on the screen.","type":"contains","points":10,"failureText":"<p><span style=\"background-color: transparent; color: rgb(0, 0, 0);\">Step 5</span></p>","requirements":[{"file":"main.ts","parameters":[{"value":"true","operator":"eq","maxValue":null,"minValue":