{
  "manifest_version": 3,
  "name": "IMPACT Block Visualizer",
  "version": "0.1.0",
  "description": "Replaces verbose [block] instruction tokens with inline SVG clones of the actual MakeCode blocks.",
  "host_permissions": [
    "https://impact.codeninjas.com/*",
    "https://api.impact.codeninjas.com/*",
    "https://*.impact.codeninjas.com/*",
    "https://arcade.makecode.com/*",
    "https://api.makecode.com/*",
    "https://cdn.makecode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://impact.codeninjas.com/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://arcade.makecode.com/*"],
      "all_frames": true,
      "js": ["renderer.js"],
      "run_at": "document_idle"
    }
  ]
}
